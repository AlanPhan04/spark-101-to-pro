<mxfile host="app.diagrams.net" agent="claude">
  <!--
    FIGURE TEMPLATE — copy to book/figures/<slug>.drawio and replace the cells.
    Rendered by book/figures/_drawio.py (straight edges, rectangles, containers).

    Legibility: pageWidth <= 640, fontSize >= 13 (titles 15), <= ~8 words per box.
    Printed size ≈ fontSize × 400 × width_fraction / pageWidth  (target >= 8 pt).
    Layout on a 20 px grid; >= 30 px between boxes; >= 20 px padding in containers.

    PALETTE — paste these style fragments verbatim (fill / stroke / font):
      blue    (driver, planner, main path)   fillColor=#cfe0f4;strokeColor=#3b6ea5;fontColor=#1f3d5c;
      green   (executors, work, fixed state) fillColor=#d8ebcf;strokeColor=#4f8a3d;fontColor=#2f5320;
      rose    (COST: shuffle, spill, skew)   fillColor=#f7dde0;strokeColor=#b5545e;fontColor=#7d2f38;strokeWidth=2;
      orange  (other party / alternative)    fillColor=#fce7d2;strokeColor=#c77f3b;fontColor=#7a4a17;
      purple  (cluster manager, envelope)    fillColor=#ece6f4;strokeColor=#6a5a8a;fontColor=#3f335c;
      gray    (client, inputs, neutral)      fillColor=#eceef1;strokeColor=#6b7280;fontColor=#374151;
      amber   (attention — max one)          fillColor=#fbeecf;strokeColor=#c9a227;fontColor=#7a5c0a;
      containers: blue #eaf1fb · green #e4f1dc · rose #fdeef0  (+ container=1;verticalAlign=top;)
      edges: main path strokeColor=#3b6ea5;strokeWidth=2  ·  shuffle strokeColor=#b5545e;strokeWidth=2
             dense shuffle strokeColor=#c99aa0  ·  control/async dashed=1;strokeColor=#6a5a8a
      annotation text: text;fillColor=none;fontColor=#57503f;
  -->
  <diagram name="figure-template" id="figtemplate">
    <mxGraphModel dx="800" dy="400" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="640" pageHeight="300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- containers first (drawn behind edges) -->
        <mxCell id="mapside" value="&lt;b&gt;Map side · stage 0&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=1;verticalAlign=top;spacingTop=8;fillColor=#eaf1fb;strokeColor=#3b6ea5;fontColor=#1f3d5c;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="reduceside" value="&lt;b&gt;Reduce side · stage 2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=1;verticalAlign=top;spacingTop=8;fillColor=#e4f1dc;strokeColor=#4f8a3d;fontColor=#2f5320;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="420" y="20" width="200" height="200" as="geometry" />
        </mxCell>

        <!-- leaf boxes -->
        <mxCell id="m1" value="scan orders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe0f4;strokeColor=#3b6ea5;fontColor=#1f3d5c;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="write shuffle files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe0f4;strokeColor=#3b6ea5;fontColor=#1f3d5c;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sh" value="&lt;b&gt;shuffle&lt;/b&gt;&lt;br&gt;disk + network" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7dde0;strokeColor=#b5545e;fontColor=#7d2f38;strokeWidth=2;dashed=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="250" y="140" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r0" value="fetch blocks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d8ebcf;strokeColor=#4f8a3d;fontColor=#2f5320;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="440" y="70" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="join + aggregate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d8ebcf;strokeColor=#4f8a3d;fontColor=#2f5320;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="440" y="150" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- edges (straight lines between vertex ids) -->
        <mxCell id="e1" style="endArrow=block;html=1;strokeColor=#3b6ea5;strokeWidth=2;" edge="1" parent="1" source="m1" target="m2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeColor=#b5545e;strokeWidth=2;" edge="1" parent="1" source="m2" target="sh">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;strokeColor=#4f8a3d;strokeWidth=2;" edge="1" parent="1" source="r0" target="r1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeColor=#b5545e;strokeWidth=2;" edge="1" parent="1" source="sh" target="r0" exitX="1" exitY="0.3" entryX="0" entryY="0.5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- one-line annotation (longer text belongs in the caption) -->
        <mxCell id="note" value="cost lives at the stage boundary" style="text;html=1;fillColor=none;strokeColor=none;align=center;fontColor=#57503f;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="160" y="240" width="320" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
