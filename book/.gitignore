# The built book and the generated figure PDFs are tracked (like the thesis
# template) so the book is readable on GitHub and builds without Python.
# Re-include them past the repo-root "*.pdf" rule:
!main.pdf
!images/*.pdf

# LaTeX build artifacts
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
comment.cut
