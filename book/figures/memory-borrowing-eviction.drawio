<mxfile host="app.diagrams.net" agent="claude">
  <diagram name="memory-borrowing-eviction" id="borrowevict">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="640" pageHeight="437" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t1" value="&lt;b&gt;1. Storage borrows idle execution space&lt;/b&gt;" style="text;html=1;align=left;fontSize=13;fontColor=#2f3b52;" vertex="1" parent="1">
          <mxGeometry x="18.3" y="13.3" width="292.6" height="31.8" as="geometry" />
        </mxCell>
        <mxCell id="a-storage2" value="&lt;b&gt;Storage&lt;/b&gt;&lt;br&gt;its own half, plus borrowed&lt;br&gt;idle execution space&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;(dashed edge: this part is borrowed, not owned)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fce7d2;strokeColor=#c77f3b;dashed=1;fontSize=13;fontColor=#7a4a17;" vertex="1" parent="1">
          <mxGeometry x="18.3" y="58.3" width="274.3" height="92.8" as="geometry" />
        </mxCell>

        <mxCell id="t2" value="&lt;b&gt;2. Execution reclaims it by evicting&lt;/b&gt;" style="text;html=1;align=left;fontSize=13;fontColor=#2f3b52;" vertex="1" parent="1">
          <mxGeometry x="347.4" y="13.3" width="292.6" height="31.8" as="geometry" />
        </mxCell>
        <mxCell id="b-exec" value="&lt;b&gt;Execution&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;a join needs&lt;br&gt;its space back&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cfe0f4;strokeColor=#3b6ea5;fontSize=13;fontColor=#1f3d5c;" vertex="1" parent="1">
          <mxGeometry x="347.4" y="58.3" width="137.1" height="92.8" as="geometry" />
        </mxCell>
        <mxCell id="b-storage" value="&lt;b&gt;Storage&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;its own half, kept&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fce7d2;strokeColor=#c77f3b;fontSize=13;fontColor=#7a4a17;" vertex="1" parent="1">
          <mxGeometry x="484.6" y="58.3" width="137.1" height="92.8" as="geometry" />
        </mxCell>
        <mxCell id="evicted" value="LRU block evicted,&lt;br&gt;recomputed later" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7dde0;strokeColor=#b5545e;fontSize=13;fontColor=#7d2f38;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="347.4" y="172.3" width="137.1" height="66.3" as="geometry" />
        </mxCell>
        <mxCell id="earrow" style="edges=1;html=1;endArrow=block;strokeColor=#b5545e;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b-exec" target="evicted"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="Execution can always evict a borrower to reclaim its half.&lt;br&gt;Storage can never evict a running task to reclaim borrowed space --- it waits." style="text;html=1;align=center;fontSize=13;fontColor=#57503f;" vertex="1" parent="1">
          <mxGeometry x="18.3" y="291.7" width="603.4" height="66.3" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>