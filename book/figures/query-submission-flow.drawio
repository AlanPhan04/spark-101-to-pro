<mxfile host="app.diagrams.net" agent="claude">
  <diagram name="query-submission-flow" id="qsflow">
    <mxGraphModel dx="900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="560" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="s1" value="&lt;b&gt;1. Client&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;sends the SQL text to the driver (your Kyuubi session)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceef1;strokeColor=#6b7280;fontSize=12;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="80" y="20" width="400" height="56" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="&lt;b&gt;2. Driver &amp;#8212; compile&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;parse &amp;#8594; analyze (catalog: trips, dim_route) &amp;#8594; optimize&lt;br&gt;&amp;#8594; physical plan; DAG scheduler cuts 3 stages at the shuffle&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe0f4;strokeColor=#3b6ea5;fontSize=12;fontColor=#1f3d5c;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="400" height="72" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="&lt;b&gt;3. Cluster manager (Kubernetes)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;driver acquires executor pods &amp;#8212; or reuses Kyuubi's warm pool&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece6f4;strokeColor=#6a5a8a;fontSize=12;fontColor=#3f335c;" vertex="1" parent="1">
          <mxGeometry x="80" y="196" width="400" height="56" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="&lt;b&gt;4. Executors &amp;#8212; stages 0 &amp; 1, in parallel&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;each task reads one partition from GCS &amp;#8594; filters &amp;#8594;&lt;br&gt;writes shuffle files to local disk, keyed by route_id&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d8ebcf;strokeColor=#4f8a3d;fontSize=12;fontColor=#2f5320;" vertex="1" parent="1">
          <mxGeometry x="80" y="276" width="400" height="72" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="&lt;b&gt;5. Shuffle&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;stage-2 tasks fetch their route_id slice from every&lt;br&gt;executor, over the network&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7dde0;strokeColor=#b5545e;fontSize=12;fontColor=#7d2f38;" vertex="1" parent="1">
          <mxGeometry x="80" y="372" width="400" height="66" as="geometry" />
        </mxCell>

        <mxCell id="s6" value="&lt;b&gt;6. Executors &amp;#8212; stage 2  (200 tasks)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;sort-merge join, then aggregate the on-time rate per route&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d8ebcf;strokeColor=#4f8a3d;fontSize=12;fontColor=#2f5320;" vertex="1" parent="1">
          <mxGeometry x="80" y="462" width="400" height="56" as="geometry" />
        </mxCell>

        <mxCell id="s7" value="&lt;b&gt;7. Driver&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;collects the ~few thousand aggregated result rows&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe0f4;strokeColor=#3b6ea5;fontSize=12;fontColor=#1f3d5c;" vertex="1" parent="1">
          <mxGeometry x="80" y="542" width="400" height="56" as="geometry" />
        </mxCell>

        <mxCell id="s8" value="&lt;b&gt;8. Client&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;receives the result set; the Spark UI shows the finished job&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceef1;strokeColor=#6b7280;fontSize=12;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="80" y="622" width="400" height="56" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="endArrow=block;html=1;strokeColor=#888888;strokeWidth=1.6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeColor=#888888;strokeWidth=1.6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeColor=#888888;strokeWidth=1.6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;strokeColor=#888888;strokeWidth=1.6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="endArrow=block;html=1;strokeColor=#888888;strokeWidth=1.6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="endArrow=block;html=1;strokeColor=#888888;strokeWidth=1.6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="endArrow=block;html=1;strokeColor=#888888;strokeWidth=1.6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="brace" value="stages 0-1: the &lt;b&gt;map side&lt;/b&gt;&lt;br&gt;stage 2: the &lt;b&gt;reduce side&lt;/b&gt;" style="text;html=1;align=left;fontSize=9;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="490" y="330" width="70" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
