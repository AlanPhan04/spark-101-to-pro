        </mxCell>

        <mxCell id="ex1" value="&lt;b&gt;Executor pod&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;spark.executor.cores task slots&lt;br&gt;runs tasks &amp;#8226; caches blocks&lt;br&gt;heartbeats to the driver&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d8ebcf;strokeColor=#4f8a3d;fontSize=13;fontColor=#2f5320;" vertex="1" parent="1">
