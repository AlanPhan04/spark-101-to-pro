<mxfile host="app.diagrams.net" agent="claude">
  <diagram name="application-topology" id="apptopo">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="780" pageHeight="430" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="client" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;your session, or the&lt;br&gt;Kyuubi SQL gateway&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceef1;strokeColor=#6b7280;fontSize=11;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="20" y="175" width="130" height="80" as="geometry" />
        </mxCell>

        <mxCell id="k8s" value="&lt;b&gt;Kubernetes API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;the cluster manager&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece6f4;strokeColor=#6a5a8a;fontSize=11;fontColor=#3f335c;" vertex="1" parent="1">
          <mxGeometry x="250" y="25" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="driver" value="&lt;b&gt;Driver&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;runs your SparkSession&lt;br&gt;plans the query (Ch. 2)&lt;br&gt;DAG + task scheduling&lt;br&gt;collects results&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe0f4;strokeColor=#3b6ea5;strokeWidth=2;fontSize=12;fontColor=#1f3d5c;" vertex="1" parent="1">
          <mxGeometry x="230" y="165" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="ex1" value="&lt;b&gt;Executor pod&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;spark.executor.cores task slots&lt;br&gt;runs tasks &amp;#8226; caches blocks&lt;br&gt;heartbeats to the driver&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d8ebcf;strokeColor=#4f8a3d;fontSize=11;fontColor=#2f5320;" vertex="1" parent="1">
          <mxGeometry x="540" y="30" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="ex2" value="&lt;b&gt;Executor pod&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;spark.executor.cores task slots&lt;br&gt;runs tasks &amp;#8226; caches blocks&lt;br&gt;heartbeats to the driver&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d8ebcf;strokeColor=#4f8a3d;fontSize=11;fontColor=#2f5320;" vertex="1" parent="1">
          <mxGeometry x="540" y="172" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="ex3" value="&lt;b&gt;Executor pod&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;spark.executor.cores task slots&lt;br&gt;runs tasks &amp;#8226; caches blocks&lt;br&gt;heartbeats to the driver&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d8ebcf;strokeColor=#4f8a3d;fontSize=11;fontColor=#2f5320;" vertex="1" parent="1">
          <mxGeometry x="540" y="314" width="220" height="95" as="geometry" />
        </mxCell>

        <mxCell id="dots" value="one application = one driver + many executors" style="text;html=1;align=center;fontSize=9;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="540" y="410" width="220" height="16" as="geometry" />
        </mxCell>

        <mxCell id="e_cli" style="endArrow=block;html=1;strokeColor=#6b7280;strokeWidth=1.6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="client" target="driver">
          <mxGeometry relative="1" as="geometry" />
          <mxPoint x="0" y="0" as="offset" />
        </mxCell>
        <mxCell id="e_cli_lbl" value="submits the query" style="text;html=1;align=center;fontSize=9;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="150" y="196" width="90" height="14" as="geometry" />
        </mxCell>

        <mxCell id="e_k8s" value="requests executors" style="endArrow=block;html=1;dashed=1;strokeColor=#6a5a8a;strokeWidth=1.4;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="driver" target="k8s">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_start" value="starts pods" style="endArrow=block;html=1;dashed=1;strokeColor=#6a5a8a;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="k8s" target="ex1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_ex1" style="endArrow=block;startArrow=block;html=1;strokeColor=#3b6ea5;strokeWidth=1.6;exitX=1;exitY=0.35;entryX=0;entryY=0.5;" edge="1" parent="1" source="driver" target="ex1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ex2" value="tasks / results / heartbeats" style="endArrow=block;startArrow=block;html=1;strokeColor=#3b6ea5;strokeWidth=1.6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="driver" target="ex2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ex3" style="endArrow=block;startArrow=block;html=1;strokeColor=#3b6ea5;strokeWidth=1.6;exitX=1;exitY=0.65;entryX=0;entryY=0.5;" edge="1" parent="1" source="driver" target="ex3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
