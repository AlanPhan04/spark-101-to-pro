        <mxCell id="k8s" value="&lt;b&gt;Kubernetes API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;the cluster manager&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece6f4;strokeColor=#6a5a8a;fontSize=13;fontColor=#3f335c;" vertex="1" parent="1">
          <mxGeometry x="205.1" y="29.7" width="147.7" height="71.4" as="geometry" />
        </mxCell>

        <mxCell id="driver" value="&lt;b&gt;Driver&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;runs your SparkSession&lt;br&gt;plans the query (Ch. 2)&lt;br&gt;DAG + task scheduling&lt;br&gt;collects results&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe0f4;strokeColor=#3b6ea5;strokeWidth=2;fontSize=13;fontColor=#1f3d5c;" vertex="1" parent="1">
