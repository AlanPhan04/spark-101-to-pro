<mxfile host="app.diagrams.net" agent="claude">
  <diagram name="application-topology" id="apptopo">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="640" pageHeight="511" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="client" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;your session:your session, or the&lt;br&gt;Kyuubi SQL gatewaylt;br&gt;shell or notebook&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceef1;strokeColor=#6b7280;fontSize=13;fontColor=#374151;" vertex="1" parent="1">
