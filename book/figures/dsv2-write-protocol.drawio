<mxfile host="app.diagrams.net" agent="claude">
  <diagram name="dsv2-write-protocol" id="dsv2write">
    <mxGraphModel dx="800" dy="400" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="640" pageHeight="350" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="d1" value="&lt;b&gt;driver&lt;/b&gt;&lt;br&gt;BatchWrite creates a&lt;br&gt;DataWriterFactory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe0f4;strokeColor=#3b6ea5;fontColor=#1f3d5c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="220" y="20" width="200" height="70" as="geometry" /></mxCell>

        <mxCell id="t0" value="&lt;b&gt;task 0&lt;/b&gt;&lt;br&gt;writes its file,&lt;br&gt;returns a message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d8ebcf;strokeColor=#4f8a3d;fontColor=#2f5320;fontSize=13;" vertex="1" parent="1"><mxGeometry x="10" y="130" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="t1" value="&lt;b&gt;task 1&lt;/b&gt;&lt;br&gt;fails: raise_error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7dde0;strokeColor=#b5545e;fontColor=#7d2f38;fontSize=13;" vertex="1" parent="1"><mxGeometry x="225" y="130" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="t2" value="&lt;b&gt;task 2&lt;/b&gt;&lt;br&gt;writes its file,&lt;br&gt;returns a message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d8ebcf;strokeColor=#4f8a3d;fontColor=#2f5320;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="190" height="70" as="geometry" /></mxCell>

        <mxCell id="ok" value="&lt;b&gt;every message arrived&lt;/b&gt;&lt;br&gt;commit(): one new snapshot,&lt;br&gt;all files become visible together" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f8a3d;fontColor=#2f5320;fontSize=13;" vertex="1" parent="1"><mxGeometry x="10" y="260" width="300" height="76" as="geometry" /></mxCell>
        <mxCell id="bad" value="&lt;b&gt;a task failed: measured&lt;/b&gt;&lt;br&gt;abort(): snapshots 1 → 1,&lt;br&gt;Parquet files on disk 2 → 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b5545e;fontColor=#7d2f38;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="260" width="300" height="76" as="geometry" /></mxCell>

        <mxCell id="e1" style="endArrow=block;html=1;strokeColor=#3b6ea5;strokeWidth=2;" edge="1" parent="1" source="d1" target="t0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeColor=#3b6ea5;strokeWidth=2;" edge="1" parent="1" source="d1" target="t1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeColor=#3b6ea5;strokeWidth=2;" edge="1" parent="1" source="d1" target="t2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;strokeColor=#4f8a3d;strokeWidth=2;" edge="1" parent="1" source="t0" target="ok"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="endArrow=block;html=1;strokeColor=#b5545e;strokeWidth=2;" edge="1" parent="1" source="t1" target="bad"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
