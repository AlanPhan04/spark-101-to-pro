<mxfile host="app.diagrams.net" agent="claude">
  <diagram name="scheduler-components" id="schedcomp">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="640" pageHeight="503" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="dag" value="&lt;b&gt;DAG scheduler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;RDD lineage -&amp;gt; stages&lt;br&gt;resubmits on fetch failure&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe0f4;strokeColor=#3b6ea5;fontSize=13;fontColor=#1f3d5c;" vertex="1" parent="1">
          <mxGeometry x="36.6" y="26.5" width="182.9" height="87.5" as="geometry" />
        </mxCell>

        <mxCell id="task" value="&lt;b&gt;Task scheduler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;places tasks, locality,&lt;br&gt;per-task retry, speculation&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe0f4;strokeColor=#3b6ea5;fontSize=13;fontColor=#1f3d5c;" vertex="1" parent="1">
          <mxGeometry x="36.6" y="167.0" width="182.9" height="87.5" as="geometry" />
        </mxCell>

        <mxCell id="mot" value="&lt;b&gt;Map output tracker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Master (driver, authoritative)&lt;br&gt;Worker (executor, cached)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7d2;strokeColor=#c77f3b;fontSize=13;fontColor=#7a4a17;" vertex="1" parent="1">
          <mxGeometry x="347.4" y="26.5" width="219.4" height="87.5" as="geometry" />
        </mxCell>

        <mxCell id="rpc" value="&lt;b&gt;RPC (Netty)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;small control&lt;br&gt;messages&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceef1;strokeColor=#6b7280;fontSize=13;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="347.4" y="167.0" width="100.6" height="87.5" as="geometry" />
        </mxCell>

        <mxCell id="block" value="&lt;b&gt;Block transfer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;large shuffle&lt;br&gt;bytes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7dde0;strokeColor=#b5545e;fontSize=13;fontColor=#7d2f38;" vertex="1" parent="1">
          <mxGeometry x="466.3" y="167.0" width="100.6" height="87.5" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="hands off a set of&#10;runnable tasks" style="edges=1;html=1;endArrow=block;strokeColor=#3b6ea5;fontSize=13;" edge="1" parent="1" source="dag" target="task"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="reads fetch&#10;locations" style="edges=1;html=1;endArrow=block;strokeColor=#c77f3b;fontSize=13;" edge="1" parent="1" source="task" target="mot"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="lost executor&#10;invalidates output" style="edges=1;html=1;endArrow=block;strokeColor=#c77f3b;fontSize=13;dashed=1;" edge="1" parent="1" source="mot" target="dag"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edges=1;html=1;endArrow=block;strokeColor=#6b7280;" edge="1" parent="1" source="task" target="rpc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edges=1;html=1;endArrow=block;strokeColor=#b5545e;" edge="1" parent="1" source="rpc" target="block"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="fetch requests /&#10;block-serving" style="edges=1;html=1;endArrow=block;strokeColor=#b5545e;fontSize=13;" edge="1" parent="1" source="mot" target="block"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="Two separate paths on purpose:&lt;br&gt;a busy shuffle fetch on the Block transfer path&lt;br&gt;never blocks the RPC call the Task scheduler needs to reassign a freed slot." style="text;html=1;align=center;fontSize=13;fontColor=#57503f;" vertex="1" parent="1">
          <mxGeometry x="36.6" y="291.7" width="530.3" height="53.0" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>