<mxfile host="app.diagrams.net" agent="claude">
  <diagram name="aqe-feedback-loop" id="aqeloop">
    <mxGraphModel dx="800" dy="400" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="640" pageHeight="340" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="drv" value="&lt;b&gt;Driver: re-plans between stages&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=1;verticalAlign=top;spacingTop=8;fillColor=#eaf1fb;strokeColor=#3b6ea5;fontColor=#1f3d5c;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="600" height="140" as="geometry" />
        </mxCell>
        <mxCell id="exe" value="&lt;b&gt;Executors: run the stages&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=1;verticalAlign=top;spacingTop=8;fillColor=#e4f1dc;strokeColor=#4f8a3d;fontColor=#2f5320;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="20" y="200" width="600" height="120" as="geometry" />
        </mxCell>

        <mxCell id="a" value="1. Read exact sizes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe0f4;strokeColor=#3b6ea5;fontColor=#1f3d5c;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b" value="2. Re-optimize the plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe0f4;strokeColor=#3b6ea5;fontColor=#1f3d5c;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="245" y="80" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c" value="3. Launch revised stage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe0f4;strokeColor=#3b6ea5;fontColor=#1f3d5c;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="450" y="80" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s0" value="Stage 0 writes shuffle files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d8ebcf;strokeColor=#4f8a3d;fontColor=#2f5320;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="160" height="56" as="geometry" />
        </mxCell>
        <mxCell id="sh" value="&lt;b&gt;shuffle stage boundary&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7dde0;strokeColor=#b5545e;fontColor=#7d2f38;strokeWidth=2;dashed=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="240" y="250" width="160" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="Stage 1 runs the revised plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d8ebcf;strokeColor=#4f8a3d;fontColor=#2f5320;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="440" y="250" width="160" height="56" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="endArrow=block;html=1;strokeColor=#4f8a3d;strokeWidth=2;" edge="1" parent="1" source="s0" target="sh"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeColor=#b5545e;strokeWidth=2;dashed=1;exitX=0.3;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="sh" target="a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeColor=#3b6ea5;strokeWidth=2;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;strokeColor=#3b6ea5;strokeWidth=2;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="endArrow=block;html=1;strokeColor=#3b6ea5;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="endArrow=block;html=1;strokeColor=#b5545e;strokeWidth=2;" edge="1" parent="1" source="sh" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell>
