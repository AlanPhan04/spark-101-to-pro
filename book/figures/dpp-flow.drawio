<mxfile host="app.diagrams.net" agent="claude">
  <diagram name="dpp-flow" id="dpp">
    <mxGraphModel dx="800" dy="400" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="640" pageHeight="380" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="lp" value="&lt;b&gt;Without DPP: pruning last&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=1;verticalAlign=top;spacingTop=8;fillColor=#fdeef0;strokeColor=#b5545e;fontColor=#7d2f38;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="290" height="340" as="geometry" />
        </mxCell>
        <mxCell id="rp" value="&lt;b&gt;With DPP: pruning first&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=1;verticalAlign=top;spacingTop=8;fillColor=#e4f1dc;strokeColor=#4f8a3d;fontColor=#2f5320;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="330" y="20" width="290" height="340" as="geometry" />
        </mxCell>

        <mxCell id="l1" value="&lt;b&gt;Scan all of orders&lt;/b&gt;&lt;br&gt;every partition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7dde0;strokeColor=#b5545e;fontColor=#7d2f38;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="l2" value="Join to dim_date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe0f4;strokeColor=#3b6ea5;fontColor=#1f3d5c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="l3" value="Discard rows that&lt;br&gt;fail the dim filter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7dde0;strokeColor=#b5545e;fontColor=#7d2f38;strokeWidth=2;dashed=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="le1" style="endArrow=block;html=1;strokeColor=#b5545e;strokeWidth=2;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le2" style="endArrow=block;html=1;strokeColor=#3b6ea5;strokeWidth=2;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="r1" value="1. Run dim_date first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe0f4;strokeColor=#3b6ea5;fontColor=#1f3d5c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="70" width="250" height="44" as="geometry" /></mxCell>
        <mxCell id="r2" value="2. Collect matching dates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe0f4;strokeColor=#3b6ea5;fontColor=#1f3d5c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="140" width="250" height="44" as="geometry" /></mxCell>
        <mxCell id="r3" value="3. Inject as a scan filter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe0f4;strokeColor=#3b6ea5;fontColor=#1f3d5c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="210" width="250" height="44" as="geometry" /></mxCell>
        <mxCell id="r4" value="&lt;b&gt;4. Scan only matching&lt;/b&gt;&lt;br&gt;partitions of orders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d8ebcf;strokeColor=#4f8a3d;fontColor=#2f5320;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="276" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="re1" style="endArrow=block;html=1;strokeColor=#3b6ea5;strokeWidth=2;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re2" style="endArrow=block;html=1;strokeColor=#3b6ea5;strokeWidth=2;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re3" style="endArrow=block;html=1;strokeColor=#4f8a3d;strokeWidth=2;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry" /></mxCell>
