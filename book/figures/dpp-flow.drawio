<mxfile host="app.diagrams.net" agent="claude">
  <diagram name="dpp-flow" id="dpp">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="740" pageHeight="360" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t1" value="&lt;b&gt;Without DPP&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontColor=#2f3b52;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="200" height="24" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="Scan ALL of orders&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;every partition, every year&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7dde0;strokeColor=#b5545e;fontSize=11;fontColor=#7d2f38;" vertex="1" parent="1">
          <mxGeometry x="20" y="44" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="Join to dim_date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceef1;strokeColor=#6b7280;fontSize=11;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="220" y="44" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="Discard rows&lt;br&gt;outside year=2026&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;pruning happens LAST&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7dde0;strokeColor=#b5545e;fontSize=11;fontColor=#7d2f38;" vertex="1" parent="1">
          <mxGeometry x="390" y="44" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edges=1;html=1;endArrow=block;strokeColor=#6b7280;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edges=1;html=1;endArrow=block;strokeColor=#6b7280;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="t2" value="&lt;b&gt;With DPP (default on)&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontColor=#2f3b52;" vertex="1" parent="1">
          <mxGeometry x="20" y="130" width="250" height="24" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="Run dim_date first&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;small, cheap to execute early&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe0f4;strokeColor=#3b6ea5;fontSize=11;fontColor=#1f3d5c;" vertex="1" parent="1">
          <mxGeometry x="20" y="164" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="Collect matching&lt;br&gt;dates: {2026-*}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe0f4;strokeColor=#3b6ea5;fontSize=11;fontColor=#1f3d5c;" vertex="1" parent="1">
          <mxGeometry x="210" y="164" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="Inject as a filter into&lt;br&gt;the orders scan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1fb;strokeColor=#3b6ea5;dashed=1;fontSize=11;fontColor=#1f3d5c;" vertex="1" parent="1">
          <mxGeometry x="400" y="164" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="Scan only matching&lt;br&gt;partitions of orders&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;pruning happens FIRST&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d8ebcf;strokeColor=#4f8a3d;fontSize=11;fontColor=#2f5320;" vertex="1" parent="1">
          <mxGeometry x="210" y="254" width="170" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e3" style="edges=1;html=1;endArrow=block;strokeColor=#3b6ea5;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edges=1;html=1;endArrow=block;strokeColor=#3b6ea5;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edges=1;html=1;endArrow=block;strokeColor=#3b6ea5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
